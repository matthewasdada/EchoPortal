    body {
        font-family: Arial;
        text-align: center;
        background-color: red !important;
    }

    h1,h2,h3 {
        color: white;
    }

    form {
        background: grey;
        padding: 20px;
        margin: 50px auto;
        width: 300px;
        border-radius: 10px;
    }

    button {
        padding: 10px;
        background-color: #dfe82e; /* yellow colour */
        color: black;
        border: none;
        border-radius: 5px;
        width: 100%;
        cursor: pointer;
    }

    button:hover {
        opacity: 0.8;
    }

    img {
        margin: 10px;
        border-radius: 10px;
    }

    .gallery {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        padding: 20px;
    }

    .card {
        background: #333;
        padding: 10px;
        border-radius: 10px;
        box-shadow: 0px 4px 10px rgba(0,0,0,00.3);
    }

    .gallery img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        border-radius: 10px;
    }

    .gallery img:hover {
        transform: scale(1.05);
        transition: 0.3s;
    }

    .content {
        max-width: 900px;
        margin: 0 auto;
        padding: 20px;
    }

    .footer {
        background: #1f1f1f;
        padding: 20px;
        text-align: center;
        margin-top: 40px;
    }

    .navbar-dark .navbar-nav .nav-link,
    .navbar-dark .navbar-nav .nav-link.active,
    .navbar-dark .navbar-nav .nav-link.show,
    .navbar-dark .navbar-nav .nav-link:visited {
        color:white !important;
    }

    .navbar-dark .navbar-nav .nav-link:hover,
    .navbar-dark .navbar-nav .nav-link:focus {
        color: #f0f0f0 !important;
    }

    .info-text {
        font-size: 0.5rem !important; 
        color: #5f5f5f !important;
        line-height: 1.5;
    }

    .home-bg {
        background-image: url('/static/images/test.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 100vh;
        position: relative;
    }

    .home-bg::before {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        z-index: 0;
    }

    .home-bg > * {
        position: relative;
        z-index: 1;
    }



